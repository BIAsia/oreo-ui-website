{
  "redirects": [
    {
      "source": "/voxel-icon",
      "destination": "https://voxel-icon.vercel.app/",
      "permanent": false
    },
    {
      "source": "/voxel-icon/:path*",
      "destination": "https://voxel-icon.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/doodle-icons",
      "destination": "https://doodle-icons.vercel.app/doodle-icons"
    },
    {
      "source": "/doodle-icons/:path*",
      "destination": "https://doodle-icons.vercel.app/doodle-icons/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
