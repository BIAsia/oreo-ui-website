{
  "functions": {
    "api/subscribe.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/voxel-icon",
      "destination": "https://voxel-icon.vercel.app/",
      "permanent": false
    },
    {
      "source": "/voxel-icon/:path(.*)",
      "destination": "https://voxel-icon.vercel.app/:path",
      "permanent": false
    },
    {
      "source": "/doodle-icons",
      "destination": "https://doodle.oreoui.com/",
      "permanent": true
    },
    {
      "source": "/doodle-icons/:path(.*)",
      "destination": "https://doodle.oreoui.com/:path",
      "permanent": true
    }
  ],
  "cleanUrls": true
}
